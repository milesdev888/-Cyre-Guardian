      ]
    },
    {
      "source": "/am.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(openapi.json|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/scan-evm.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/apps",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/airdrop",
      "permanent": true
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "https://cyre-fraud-prediction.onrender.com/.well-known/agent-card.json",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/multichain-scan",
      "destination": "https://guardian-scan.onrender.com/api/scan"
    },
    {
      "source": "/api/passport/verify",
      "destination": "/api/passport-verify"
    },
    {
